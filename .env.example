AGENTROUTER_API_KEY=replace-with-your-key
AGENTROUTER_MODEL=gpt-6.1-sol
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# codex or claude-code. The selected profile sets client identification headers.
AGENTROUTER_CLIENT=codex
# Optional: override the entire User-Agent value.
# AGENTROUTER_USER_AGENT=codex_cli_rs/0.120.0

# Game server
# The deployed FlatEarther contract and the block it was deployed in.
GAME_ADDRESS=
START_BLOCK=
# The judge wallet: it pays the pot when Earl is beaten. Keep only a little ETH in it for gas.
JUDGE_PRIVATE_KEY=
# Server-side RPC. Use Alchemy in production; the public RPC is rate limited.
# RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/your-key
# How hard Earl and the referee think: low, medium, high, xhigh or max.
# Low keeps Earl beatable by a well-built trap; medium Earl almost never slips.
EARL_EFFORT=low
REFEREE_EFFORT=medium
# The site's public address (https://...), used for link preview images on X and Discord.
# Left empty, the server works it out from each request.
PUBLIC_URL=
# Where the "Get $WIF" link goes.
BUY_WIF_URL=https://worldisflat.fun
PORT=3000
DATA_FILE=data/game.json
